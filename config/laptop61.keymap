#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* 物理1段目：15キー */
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4
                &kp N5   &kp N6  &kp N7  &kp N8  &kp N9
                &kp N0   &kp MINUS &kp EQUAL &kp BSLH &kp GRAVE

                /* 物理2段目：14キー */
                &kp TAB  &kp Q  &kp W  &kp E  &kp R
                &kp T    &kp Y  &kp U  &kp I  &kp O
                &kp P    &kp LBKT &kp RBKT &kp DEL

                /* 物理3段目：13キー */
                &kp LCTRL &kp A &kp S &kp D &kp F
                &kp G     &kp H &kp J &kp K &kp L
                &kp SEMI  &kp APOS &kp ENTER

                /* 物理4段目：13キー */
                &kp LSHFT &kp Z &kp X &kp C &kp V
                &kp B     &kp N &kp M &kp COMMA &kp DOT
                &kp FSLH  &kp RSHFT &mo 1

                /* 物理5段目：6キー */
                &kp LALT &kp LGUI &kp SPACE
                &kp SPACE &kp RGUI &kp RALT
            >;
        };

        fn_layer {
            bindings = <
                /* 物理1段目：F1〜F12 */
                &trans &kp F1 &kp F2 &kp F3 &kp F4
                &kp F5  &kp F6 &kp F7 &kp F8 &kp F9
                &kp F10 &kp F11 &kp F12 &trans &trans

                /* 物理2段目 */
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans

                /* 物理3段目：HJKLでカーソル移動 */
                &trans &trans &trans &trans &trans
                &trans &trans &kp LEFT &kp DOWN &kp UP
                &kp RIGHT &trans &trans

                /* 物理4段目 */
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &trans &trans &trans

                /* 物理5段目 */
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
