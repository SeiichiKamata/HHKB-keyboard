
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* 物理1段目：15キー */
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4
                &kp N5   &kp N6  &kp N7  &kp N8  &kp N9
                &kp N0   &kp MINUS &kp EQUAL &kp BSLH &kp GRAVE

                /* 物理2段目：14キー */
                &kp TAB  &kp Q  &kp W  &kp E  &kp R
                &kp T    &kp Y  &kp U  &kp I  &kp O
                &kp P    &kp LBKT &kp RBKT &kp DEL

                /* 物理3段目：13キー */
                &kp LCTRL &kp A &kp S &kp D &kp F
                &kp G     &kp H &kp J &kp K &kp L
                &kp SEMI  &kp APOS &kp ENTER

                /* 物理4段目：13キー */
                &kp LSHFT &kp Z &kp X &kp C &kp V
                &kp B     &kp N &kp M &kp COMMA &kp DOT
                &kp FSLH  &kp RSHFT &mo 1

                /* 物理5段目：6キー */
                &kp LALT &kp LGUI &kp SPACE
                &kp SPACE &kp RGUI &kp RALT
            >;
        };

        fn_layer {
            bindings = <
                /* 物理1段目：Esc=Power、数字列=F1〜F12 */
                &kp K_POWER &kp F1 &kp F2 &kp F3 &kp F4
                &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp F10 &kp F11 &kp F12 &kp INS &kp DEL

                /* 物理2段目 */
                &kp CAPS &trans &trans &trans &trans
                &trans &trans &trans &kp PSCRN &kp SLCK
                &kp PAUS &kp UP &trans &kp BSPC

                /* 物理3段目 */
                &trans &kp K_VOL_DN &kp K_VOL_UP &kp K_MUTE &kp K_EJECT
                &trans &kp KP_MULTIPLY &kp KP_DIVIDE &kp HOME &kp PG_UP
                &kp LEFT &kp RIGHT &kp KP_ENTER

                /* 物理4段目 */
                &trans &trans &trans &trans &trans
                &trans &kp KP_PLUS &kp KP_MINUS &kp END &kp PG_DN
                &kp DOWN &trans &trans

                /* 物理5段目：右Command=Stop */
                &trans &trans &trans &trans &kp K_STOP &trans
            >;
        };
    };
};
